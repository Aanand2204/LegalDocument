# Copy to .env and adjust as needed. All values below are the defaults
# config.py falls back to if a variable is unset.

# SQLAlchemy database URL. Defaults to zero-setup local SQLite; set this
# to your Aiven PostgreSQL service's connection string to use Aiven
# instead (get it from the Aiven console — Service overview -> Connection
# information -> "Service URI", then swap the scheme to
# postgresql+psycopg://). Aiven requires TLS, hence sslmode=require. This
# file only ever holds a placeholder — put your real value in your own
# .env (gitignored), never here.
DATABASE_URL=sqlite:///./legalguard.db
# DATABASE_URL=postgresql+psycopg://USERNAME:PASSWORD@HOST:PORT/defaultdb?sslmode=require

# LLM backend for all agents. "mock" needs no API key and runs fully
# offline using deterministic heuristics (see llm/mock_client.py).
# No other provider is implemented yet — see llm/client.py.
LLM_PROVIDER=mock

# Where uploaded contract files are stored on local disk.
DOCUMENTS_DIR=./documents

# Governance thresholds (see governance/rules.py). Risk scores >= this
# value, or AI confidence below this fraction, force human review.
RISK_REVIEW_THRESHOLD=61
CONFIDENCE_REVIEW_THRESHOLD=0.75

# Login sessions (see app/services/auth_service.py, app/api/auth.py).
# Sessions are opaque tokens stored in the database, not signed JWTs —
# there is no secret key to set here or anywhere. The cookie itself has
# no expiry (browsers clear it when the browser closes); server-side, a
# session lapses after this many minutes with no requests (a sliding
# window, refreshed on every authenticated request — not a fixed
# lifetime). Set SESSION_COOKIE_SECURE to true once you're serving over
# HTTPS.
SESSION_INACTIVITY_MINUTES=180
SESSION_COOKIE_SECURE=false

# Application logging (see app/logging_config.py). Console + logs/app.log.
LOG_LEVEL=INFO
